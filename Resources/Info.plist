<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Contour</string>
	<key>CFBundleDisplayName</key>
	<string>Contour</string>
	<key>CFBundleExecutable</key>
	<string>Contour</string>
	<key>CFBundleIdentifier</key>
	<string>com.nahak.contour</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.2.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>14.4</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Contour captures system audio so it can apply EQ and plugin processing before sending it to your audio interface.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Contour reads system audio back from BlackHole, which macOS treats as an audio input device. No microphone is recorded.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Contour renders audio continuously and is the only thing draining
	     BlackHole. Adding a Window scene made AppKit treat it as a windowed app
	     and terminate it as idle whenever no window was open. -->
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
