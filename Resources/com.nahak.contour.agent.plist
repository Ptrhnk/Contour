<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match this file's name, which SMAppService requires. -->
	<key>Label</key>
	<string>com.nahak.contour.agent</string>

	<!-- Relative to the app bundle, so the agent follows the bundle rather
	     than baking in an absolute path. -->
	<key>BundleProgram</key>
	<string>Contents/MacOS/Contour</string>

	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.nahak.contour</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<!-- The watchdog. Restart only on abnormal exit: quitting from the menu
	     exits zero and stays quit, while a plugin taking the process down
	     brings it straight back.

	     This is not a nicety. Plugins are hosted in-process on purpose, so a
	     third-party AU that segfaults kills Contour — and because BlackHole is
	     the system output with nothing else draining it, that means silence
	     rather than merely unprocessed audio. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
